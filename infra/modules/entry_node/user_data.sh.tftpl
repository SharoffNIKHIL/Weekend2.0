#!/usr/bin/env bash
# infra/modules/entry_node/user_data.sh.tftpl
# First-boot only: join the tailnet. Caddy (HTTPS on the tailnet name) and the
# SigV4 signing proxy to the Lambda Function URL are configured by Ansible (Phase 2).
set -euo pipefail

hostnamectl set-hostname "${hostname}"

# Tailscale from its official package repo (no curl | sh).
dnf config-manager --add-repo https://pkgs.tailscale.com/stable/amazon-linux/2023/tailscale.repo
dnf -y install tailscale
systemctl enable --now tailscaled

# Auth key lives only in Secrets Manager (P4); read it with the instance role, use it, drop it.
# The secret value is set outside Terraform. If it is not there yet, wait for it
# (max ~20 min) instead of failing: user_data runs only once.
AUTHKEY=""
for attempt in $(seq 1 40); do
  if AUTHKEY="$(aws secretsmanager get-secret-value --region "${region}" --secret-id "${tailscale_secret_id}" --query SecretString --output text 2>/dev/null)" && [ -n "$AUTHKEY" ]; then
    break
  fi
  echo "weekend2: tailscale auth key not set yet (attempt $attempt/40); retrying in 30 s" >&2
  sleep 30
done
if [ -z "$AUTHKEY" ]; then
  echo "weekend2: ERROR no tailscale auth key after 40 attempts; set the secret, then run: terraform apply -replace=module.entry_node.aws_instance.this" >&2
  exit 1
fi

tailscale up --authkey="$AUTHKEY" --hostname="${hostname}" --advertise-tags="${tailscale_tag}"
unset AUTHKEY
