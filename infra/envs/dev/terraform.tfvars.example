# infra/envs/dev/terraform.tfvars.example
# Dev values are NOT in the code. They live in the GitHub `dev` environment secrets
# (docs/BRANCHING.md). This file shows the format.
#   GitHub secret GCP_PROJECT_ID          = project_id
#   GitHub secret GCP_BILLING_ACCOUNT_ID  = billing_account_id
#   GitHub secret ALERT_EMAIL             = alert_email
#   GitHub secret TFVARS                  = the "Non-sensitive dev values" block below
# For a LOCAL plan, copy this file to terraform.tfvars (git-ignored) and fill it in.
# GitHub secrets are write-only, so keep your own copy (e.g. in a password manager).

project_id         = "<GCP_PROJECT_ID>"
billing_account_id = "<BILLING_ACCOUNT_ID>"
alert_email        = "<ALERT_EMAIL>"

# --- Non-sensitive dev values (content of the TFVARS secret) ---
env                     = "dev"
region                  = "asia-south1"
node_region             = "us-central1"   # always-free e2-micro region (dev holds no real data)
node_zone               = "us-central1-a"
subnet_cidr             = "10.30.0.0/24"
entry_node_enabled      = true
entry_node_machine_type = "e2-micro"
tailnet_hostname        = "node-d1"
tailscale_tag           = "tag:weekend-dev"
vertex_location         = "global"
model_default           = "claude-haiku-4-5@20251001"
model_strong            = "claude-haiku-4-5@20251001"
budget_amount_inr       = 850
