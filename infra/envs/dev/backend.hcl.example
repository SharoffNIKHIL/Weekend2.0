# infra/envs/dev/backend.hcl.example — copy to backend.hcl (git-ignored)
# Same state bucket as prod (created by infra/bootstrap), separate key.
bucket       = "weekend2-tfstate-<AWS_ACCOUNT_ID>"
key          = "dev/terraform.tfstate"
region       = "ap-south-1"
encrypt      = true
use_lockfile = true # native S3 state locking (Terraform >= 1.10); no DynamoDB table
