# infra/values/env.tfvars.example — TEMPLATE for infra/values/<env>.tfvars
# A values file is committed ONLY on its environment's branch (dev.tfvars on `dev`, prod.tfvars on
# `prod`). `main` and `release` hold this template only (docs/BRANCHING.md; branch-guard enforces it).
# Never put identifying values here: project_id, billing_account_id and alert_email come from
# GitHub environment secrets (CI) or ../credentials/<project>-<env>.secrets.tfvars (your Mac).

env               = "<env>"           # dev | prod | … (2-8 lowercase chars)
owner             = "<owner-label>"
region            = "<region>"        # e.g. asia-south1
backup_location   = "<location>"      # null = region
node_region       = "<region>"
node_zone         = "<zone>"
subnet_cidr       = "<cidr>"
budget_amount_inr = 0                 # monthly, before tax

# Cost switches (omit = off)
enable_cmek        = false
entry_node_enabled = false
entry_node_egress  = "nat"

# Protection and retention (omit = secure defaults)
deletion_protection             = true
firestore_pitr                  = false
firestore_backup_retention_days = 7
backup_retention_days           = 35
backup_soft_delete_days         = 7

# App
log_level         = "INFO"
api_max_instances = 1
vertex_location   = "global"
model_default     = "<vertex-model-id>"
model_strong      = "<vertex-model-id>"
tailscale_tag     = "tag:<tag>"
secrets = {
  "tailscale/authkey"       = "Tailscale auth key for the entry node"
  "app/session-signing-key" = "HMAC key for owner session tokens"
}
api_secret_env = {
  session_signing_key = "app/session-signing-key"
}
