# infra/values/secrets.tfvars.example — identifying values, NEVER committed.
# CI writes them from GitHub environment secrets into infra/stack/secrets.auto.tfvars.
# On your Mac they live in ../credentials/<project>-<env>.secrets.tfvars (outside the repo).
project_id         = "<GCP_PROJECT_ID>"
billing_account_id = "<BILLING_ACCOUNT_ID>"
alert_email        = "<ALERT_EMAIL>"
owner_principal    = "user:<OWNER_EMAIL>"   # bootstrap only
