# .gitignore
.DS_Store
.venv/
venv/
__pycache__/
*.pyc
# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Env values are never committed: they live in GitHub environment secrets (docs/BRANCHING.md)
backend.hcl
crash.log
# Terraform saved plans hold variable values (account ID, e-mail) in cleartext
tfplan
*.tfplan
*.plan
infra/modules/app/.build/
# Tailscale policy with your real login (template stays public)
*.local.hujson
# Office lock files
~$*
# Private project memory (kept local, not public)
PROJECT_MEMORY.md
# Java build output
app/target/
*.class
