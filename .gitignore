# .gitignore
.DS_Store
.venv/
venv/
__pycache__/
*.pyc
# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
crash.log
# Terraform saved plans hold variable values (account ID, e-mail) in cleartext
tfplan
*.tfplan
*.plan
infra/modules/app/.build/
# Tailscale policy with your real login (template stays public)
*.local.hujson
# Office lock files
~$*
# Private project memory (kept local, not public)
PROJECT_MEMORY.md
